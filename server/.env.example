# =================================================================
# MediLink AI — Server Environment Configuration Template
# =================================================================

# Server Port
PORT=5000

# Database Mode: 'mongodb' (MongoDB Atlas) or 'memory' (in-memory mock)
DB_MODE=mongodb

# MongoDB Atlas Connection String
# 1. Create a free cluster on https://cloud.mongodb.com
# 2. Add Database User (Username & Password) & IP Access (0.0.0.0/0 for dev)
# 3. Paste your connection string below:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/medilink?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=medilink-ai-super-secure-jwt-secret-2026

# Cloudinary CDN Configuration (For ESP32-CAM Image Storage)
# Free account at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Local LLM / Ollama Endpoint (Default Ollama address)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=glm4

# ESP32-CAM Microcontroller Hardware Link (Optional local IP)
ESP32_CAM_IP=http://192.168.1.100
