# Database Mode: Set to 'mongodb' or 'atlas' for MongoDB Atlas, 'memory' for in-memory, or 'firestore' for Firebase
DB_MODE=mongodb

# MongoDB Atlas Connection String
# Replace <username>, <password>, and cluster domain with your MongoDB Atlas details
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/medilink?retryWrites=true&w=majority

# Firebase Configuration (Optional if using DB_MODE=firestore)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-client-email@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# JWT Secret
JWT_SECRET=medilink-ai-jwt-secret-change-in-production

# Server Port
PORT=5000
